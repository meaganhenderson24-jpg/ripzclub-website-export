# Example only. No real credentials belong in this file or in GitHub.
# Prefer GoDaddy's protected environment settings for the running application.
# Never place a real .env file inside the publicly served dist/public folder.

# Required for the live application.
NODE_ENV=production

# Use the numeric port assigned by your hosting setup, if one is assigned.
# Without PORT, the current application listens on 3000.
# PORT=3000

# Required only when enabling/migrating database-backed features.
# Supply the real value privately; leaving this blank does not configure MySQL.
# Format: mysql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Required for the existing Discord role-management buttons.
# Supply the existing bot token privately; never commit it.
DISCORD_BOT_TOKEN=

# Optional operating-system timezone. Show/calendar code already explicitly
# uses Australia/Sydney, so this setting does not replace its date conversion.
# TZ=Australia/Sydney

# Do not copy Manus platform secrets just to suppress unused login warnings.
# Audit/remove unused platform features, or configure them deliberately with
# an authorised provider if you decide to retain them. See the review guide.
